---
// Folha de desenho técnico: o percurso da ferramenta (laranja) desenha-se sozinho,
// operação a operação. Ao passar o rato, mostra a mira e as coordenadas em mm.
const W = 720, H = 480, M = 24.5; // tamanho da folha e margem interior
const colunas = ["A", "B", "C", "D", "E", "F"];
const linhas = ["1", "2", "3", "4"];
const cw = (W - 2 * M) / colunas.length, rh = (H - 2 * M) / linhas.length;
const furos = [[145, 135], [520, 135], [565, 315], [145, 315]];
---
<svg class="drawing" viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Desenho técnico de uma peça, com o percurso da ferramenta a ser gerado automaticamente.">
  <defs>
    <marker id="seta" viewBox="0 0 10 10" refX="10" refY="5" markerWidth="8" markerHeight="8" orient="auto-start-reverse">
      <path class="d-arrow" d="M0,1.5 L10,5 L0,8.5 z" />
    </marker>
  </defs>

  <!-- folha: esquadria, zonas e legenda -->
  <rect class="d-frame" x="8.5" y="8.5" width={W - 17} height={H - 17} />
  <rect class="d-frame" x={M} y={M} width={W - 2 * M} height={H - 2 * M} />
  {colunas.map((c, i) => (
    <>
      {i > 0 && <path class="d-frame" d={`M${M + i * cw},8.5 V${M} M${M + i * cw},${H - M} V${H - 8.5}`} />}
      <text class="d-txt s" x={M + (i + .5) * cw} y="19.5" text-anchor="middle">{c}</text>
      <text class="d-txt s" x={M + (i + .5) * cw} y={H - 13.5} text-anchor="middle">{c}</text>
    </>
  ))}
  {linhas.map((l, i) => (
    <>
      {i > 0 && <path class="d-frame" d={`M8.5,${M + i * rh} H${M} M${W - M},${M + i * rh} H${W - 8.5}`} />}
      <text class="d-txt s" x="16.5" y={M + (i + .5) * rh + 3} text-anchor="middle">{l}</text>
      <text class="d-txt s" x={W - 16.5} y={M + (i + .5) * rh + 3} text-anchor="middle">{l}</text>
    </>
  ))}
  <g>
    <rect class="d-frame" x="476" y="414" width="219.5" height="41.5" />
    <path class="d-frame" d="M560,414 V455.5 M640,414 V455.5 M476,434.5 H695.5" />
    <text class="d-txt s hi" x="482" y="428">SOLIDLYNX</text>
    <text class="d-txt s" x="566" y="428">PEÇA 001</text>
    <text class="d-txt s" x="646" y="428">ESC 1:5</text>
    <text class="d-txt s" x="482" y="449">AUTOMÁTICO</text>
    <text class="d-txt s" x="566" y="449">MAT. —</text>
    <text class="d-txt s" x="646" y="449">REV A</text>
  </g>

  <!-- peça -->
  <path class="d-part" d="M110,100 H560 L600,140 V350 H110 Z" />
  <rect class="d-part" x="215" y="165" width="190" height="120" rx="12" />
  <rect class="d-part" x="450" y="215" width="80" height="30" rx="15" />
  {furos.map(([x, y]) => (
    <>
      <circle class="d-hole" cx={x} cy={y} r="7" />
      <path class="d-center" d={`M${x - 14},${y} H${x + 14} M${x},${y - 14} V${y + 14}`} />
    </>
  ))}
  <path class="d-center" d="M436,230 H544 M310,150 V300 M200,225 H420" />

  <!-- cotas -->
  <path class="d-dim" d="M110,358 V402 M600,358 V402 M102,100 H58 M102,350 H58" />
  <path class="d-dim" d="M110,394 H600" marker-start="url(#seta)" marker-end="url(#seta)" />
  <path class="d-dim" d="M66,100 V350" marker-start="url(#seta)" marker-end="url(#seta)" />
  <text class="d-txt" x="355" y="388" text-anchor="middle">600</text>
  <text class="d-txt" x="60" y="225" text-anchor="middle" transform="rotate(-90 60 225)">300</text>
  <path class="d-dim" d="M150,321 L180,372 H232" />
  <text class="d-txt" x="184" y="367">4× Ø16</text>
  <path class="d-dim" d="M586,126 L626,86 H668" />
  <text class="d-txt" x="630" y="81">C40</text>
  <path class="d-dim" d="M400,170 L432,128 H486" />
  <text class="d-txt" x="436" y="123">R12 P8</text>

  <!-- percurso da ferramenta -->
  <path class="tp tp-anim tp-contour" pathLength="1" d="M84,74 L104,94 H562.4 L606,137.6 V356 H104 V94" />
  {furos.map(([x, y], i) => <circle class="tp-hole" cx={x} cy={y} r="5" style={`animation-delay:${i * .35}s`} />)}
  <rect class="tp-fill" x="215" y="165" width="190" height="120" rx="12" />
  <path class="tp tp-anim tp-pocket" pathLength="1" d="M224,174 H396 V186 H224 V198 H396 V210 H224 V222 H396 V234 H224 V246 H396 V258 H224 V270 H396 V276 H224 M227,170 H393 A7,7 0 0 1 400,177 V273 A7,7 0 0 1 393,280 H227 A7,7 0 0 1 220,273 V177 A7,7 0 0 1 227,170 Z" />
  <path class="tp-cut tp-slot" pathLength="1" d="M465,230 H515" />
  <path class="tp tp-anim tp-slot" pathLength="1" d="M465,230 H515" />

  <!-- estado da operação e coordenadas -->
  <rect class="st-dot" x="40" y="40" width="7" height="7" />
  <text class="d-txt st st-1" x="54" y="47">OP 01 · CONTORNO</text>
  <text class="d-txt st st-2" x="54" y="47">OP 02 · FURAÇÃO</text>
  <text class="d-txt st st-3" x="54" y="47">OP 03 · CAIXA E RANHURA</text>
  <text class="d-txt st st-done" x="54" y="47">CONCLUÍDO · SEM CLIQUES</text>
  <text class="d-txt d-xy" x="680" y="47" text-anchor="end">X 000.0  Y 000.0</text>

  <g class="d-cross">
    <line x1={M} x2={W - M} y1="240" y2="240" />
    <line x1="360" x2="360" y1={M} y2={H - M} />
  </g>
</svg>

<script>
  const svg = document.querySelector<SVGSVGElement>(".drawing");
  const xy = svg?.querySelector(".d-xy");
  const [h, v] = [...(svg?.querySelectorAll(".d-cross line") ?? [])];
  const num = (n: number) => (n < 0 ? "-" : " ") + Math.abs(n).toFixed(1).padStart(5, "0");
  svg?.addEventListener("pointermove", e => {
    const m = svg.getScreenCTM();
    if (!m || !xy || !h || !v) return;
    const p = new DOMPoint(e.clientX, e.clientY).matrixTransform(m.inverse());
    const x = Math.min(695.5, Math.max(24.5, p.x)), y = Math.min(455.5, Math.max(24.5, p.y));
    h.setAttribute("y1", String(y)); h.setAttribute("y2", String(y));
    v.setAttribute("x1", String(x)); v.setAttribute("x2", String(x));
    // a peça tem 600 × 300 mm, desenhada entre x 110–600 e y 100–350
    xy.textContent = `X${num((x - 110) * 600 / 490)}  Y${num((350 - y) * 300 / 250)}`;
    svg.classList.add("hover");
  });
  svg?.addEventListener("pointerleave", () => svg.classList.remove("hover"));
</script>
