---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const links = [
  { href: "#servicos", t: "Serviços" },
  { href: "#como", t: "Como funciona" },
  { href: "#preco", t: "Preço" },
  { href: "#contacto", t: "Contacto" },
];
---
<header class="top">
  <div class="wrap top-in">
    <a class="logo" href={`${base}/`}><img src={`${base}/logo.png`} alt="SolidLynx" width="900" height="273" /></a>
    <nav class="menu" id="menu" aria-label="Principal">
      <ul>{links.map(l => <li><a href={`${base}/${l.href}`}>{l.t}</a></li>)}</ul>
    </nav>
    <a class="btn btn-sm top-cta" href={`${base}/#contacto`}>Pedir proposta</a>
    <button class="nav-toggle" type="button" aria-label="Abrir menu" aria-expanded="false" aria-controls="menu"><span></span></button>
  </div>
</header>
