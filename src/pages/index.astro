---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import HeroDrawing from "../components/HeroDrawing.astro";
import { empresa } from "../data/empresa";
const email = empresa.emailGeral;
const services = [
  { t: "Automação no AlphaCAM", d: "O trabalho que hoje fazes móvel a móvel passa a correr sozinho, para todos de uma vez e à maneira da tua empresa." },
  { t: "Do AlphaCAM ao bSuite", d: "A passagem para o bSuite também é automática: nada de abrir e guardar ficheiro a ficheiro." },
  { t: "Processos e tarefas repetitivas", d: "Noutro programa ou entre programas: se um passo se repete todos os dias, automatizamo-lo à tua medida." },
];
const perks = [
  { t: "Só refaz o que mudou", d: "Corres outra vez e só são processados os móveis novos ou alterados." },
  { t: "Sem janelas a interromper", d: "Os avisos que já conhecemos são respondidos sozinhos, sem ninguém ao lado." },
  { t: "Os erros chegam-nos sozinhos", d: "Cada trabalho envia-nos um resumo técnico, nunca os teus ficheiros. Corrigimos sem teres de avisar." },
];
const steps = [
  { t: "Fala-nos do processo", d: "Contas-nos o que se repete." },
  { t: "Otimizamos", d: "Desenhamos o processo mais simples." },
  { t: "Desenvolvemos", d: "Entregas curtas e frequentes." },
  { t: "Entregamos", d: "Pronto a usar, em SaaS." },
];
const spec = [
  { k: "Modelo", v: "Subscrição (SaaS)" },
  { k: "Preço", v: "Por funcionalidade: pagas só o que usas" },
  { k: "Desenvolvimento", v: "Contínuo, com entregas curtas e frequentes" },
  { k: "Correções", v: "Incluídas na subscrição" },
  { k: "Contacto", v: "Direto, com quem desenvolve" },
];
---
<Layout title="SolidLynx · Foca-te no que interessa" description="Automatizamos processos e tarefas repetitivas em CAD/CAM, no AlphaCAM e no bSuite, em formato SaaS.">
  <Header />

  <main>
    <section class="hero">
      <div class="wrap">
        <p class="hero-meta label"><span>Automação CAD/CAM</span><span>AlphaCAM · bSuite</span><span>SaaS</span></p>
        <h1>Foca-te no que<br />interessa<span class="dot">.</span></h1>
        <div class="hero-grid">
          <div class="hero-copy">
            <p class="lead">Automatizamos processos e tarefas repetitivas em CAD/CAM, a começar pelo AlphaCAM e pelo bSuite: o que hoje se faz à mão passa a correr sozinho. Em formato SaaS, com desenvolvimento e correções contínuas.</p>
            <div class="cta">
              <a class="btn" href="#contacto">Pedir proposta <span class="arr" aria-hidden="true">→</span></a>
              <a class="link" href="#como">Como funciona</a>
            </div>
          </div>
          <figure class="hero-fig"><HeroDrawing /></figure>
        </div>
      </div>
    </section>

    <section id="servicos" class="section">
      <div class="wrap">
        <div class="sec-head">
          <p class="sec-label"><b>01</b>Serviços</p>
          <h2>O que fazemos</h2>
        </div>
        <ol class="svc">
          {services.map((s, i) => (
            <li>
              <span class="svc-n">{String(i + 1).padStart(2, "0")}</span>
              <h3>{s.t}</h3>
              <div class="svc-body">
                <p>{s.d}</p>
              </div>
            </li>
          ))}
        </ol>
        <div class="perks">
          <p class="sec-label">Em cada trabalho</p>
          <ul>
            {perks.map(p => <li><h3>{p.t}</h3><p>{p.d}</p></li>)}
          </ul>
        </div>
        <p class="tm-note">AlphaCAM e bSuite são marcas dos respetivos titulares. A SolidLynx não é afiliada aos seus fabricantes.</p>
      </div>
    </section>

    <section id="como" class="section sheet">
      <div class="wrap">
        <div class="sec-head">
          <p class="sec-label"><b>02</b>Como funciona</p>
          <h2>Em 4 passos</h2>
        </div>
        <div class="flow-wrap">
          <ol class="flow">
            {steps.map((s, i) => (
              <li>
                <span class="flow-node" aria-hidden="true"></span>
                <span class="flow-n">{String(i + 1).padStart(2, "0")}</span>
                <h3>{s.t}</h3>
                <p>{s.d}</p>
              </li>
            ))}
          </ol>
          <div class="loop" aria-hidden="true"><span>Melhoria contínua</span></div>
        </div>
      </div>
    </section>

    <section id="preco" class="section">
      <div class="wrap">
        <div class="sec-head">
          <p class="sec-label"><b>03</b>Preço</p>
          <h2>Simplicidade e eficiência</h2>
        </div>
        <div class="price">
          <div class="price-lead">
            <p class="price-big">Pagas só o que usas.</p>
            <p>Cada funcionalidade tem preço próprio. E falas sempre com quem desenvolve.</p>
            <a class="btn" href="#contacto">Pedir proposta <span class="arr" aria-hidden="true">→</span></a>
          </div>
          <dl class="spec">
            {spec.map(s => <div><dt>{s.k}</dt><dd>{s.v}</dd></div>)}
          </dl>
        </div>
      </div>
    </section>

    <section id="contacto" class="contact">
      <div class="wrap">
        <p class="sec-label"><b>04</b>Contacto</p>
        <h2>Pronto para te focares no que interessa?</h2>
        <a class="mail" href={`mailto:${email}`}>{email} <span class="arr" aria-hidden="true">→</span></a>
        <p class="contact-note">Conta-nos o que se repete no teu dia a dia. Respondemos com uma proposta.</p>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
