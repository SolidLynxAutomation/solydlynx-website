---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import HeroDrawing from "../components/HeroDrawing.astro";
import { empresa } from "../data/empresa";
const email = empresa.emailGeral;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const services = [
  { t: "Automação ponta\u00a0a\u00a0ponta", d: "Integramos o AlphaCAM, o bSuite e outros programas num único fluxo automático, construído à medida das regras e dos métodos da tua empresa." },
  { t: "IA e agentes", d: "Juntamos inteligência artificial e agentes à automação, para as tarefas que pedem mais do que regras fixas." },
  { t: "Tarefas repetitivas", d: "Se um passo se repete todos os dias, automatizamo-lo à tua medida." },
  { t: "Consultoria no mobiliário", d: "Desenvolvemos sistemas e métodos de trabalho para empresas de mobiliário, do gabinete técnico ao chão de fábrica." },
];
const perks = [
  { t: "Feito para a tua empresa", d: "Adaptamo-nos às tuas regras e aos teus métodos, não o contrário." },
  { t: "Acompanhamento contínuo", d: "Seguimos cada automação de perto e corrigimos depressa o que for preciso." },
  { t: "Contacto direto", d: "Falas sempre com quem desenvolve, sem intermediários." },
];
const steps = [
  { t: "Fala-nos do processo", d: "Contas-nos o que se repete." },
  { t: "Otimizamos", d: "Desenhamos o processo mais simples." },
  { t: "Desenvolvemos", d: "Entregas curtas e frequentes." },
  { t: "Entregamos", d: "Pronto a usar no dia a dia." },
];
---
<Layout title="SolidLynx · Foca-te no que interessa" description="Automação ponta a ponta no AlphaCAM, no bSuite e noutros programas, com IA e agentes. Consultoria em sistemas e métodos de trabalho para o mobiliário.">
  <Header />

  <main>
    <section class="hero">
      <div class="wrap">
        <p class="hero-meta label"><span>Automação ponta a ponta</span><span>CAD/CAM</span><span>IA e agentes</span><span>Consultoria</span></p>
        <h1>Foca-te no que<br />interessa<span class="dot">.</span></h1>
        <div class="hero-grid">
          <div class="hero-copy">
            <p class="lead">Nós tratamos do resto. Automatizamos processos de ponta&nbsp;a&nbsp;ponta, nos programas que já usas, com IA e agentes. No mobiliário, criamos também sistemas e métodos de trabalho, do gabinete técnico ao chão de fábrica.</p>
            <div class="cta">
              <a class="btn" href="#contacto">Pedir proposta <span class="arr" aria-hidden="true">→</span></a>
              <a class="link" href="#como">Como funciona</a>
            </div>
          </div>
          <figure class="hero-fig"><HeroDrawing /></figure>
        </div>
      </div>
    </section>

    <section id="servicos" class="section">
      <div class="wrap">
        <div class="sec-head">
          <p class="sec-label"><b>01</b>Serviços</p>
          <h2>O que fazemos</h2>
        </div>
        <ol class="svc">
          {services.map((s, i) => (
            <li>
              <span class="svc-n">{String(i + 1).padStart(2, "0")}</span>
              <h3>{s.t}</h3>
              <div class="svc-body">
                <p>{s.d}</p>
              </div>
            </li>
          ))}
        </ol>
        <div class="perks">
          <p class="sec-label">Em todos os projetos</p>
          <ul>
            {perks.map(p => <li><h3>{p.t}</h3><p>{p.d}</p></li>)}
          </ul>
        </div>
        <p class="tm-note">AlphaCAM, bSuite e os restantes programas mencionados são marcas dos respetivos titulares. A SolidLynx é independente e não tem qualquer afiliação com os seus fabricantes. <a href={`${base}/termos#terceiros`}>Saber mais</a></p>
      </div>
    </section>

    <section id="como" class="section sheet">
      <div class="wrap">
        <div class="sec-head">
          <p class="sec-label"><b>02</b>Como funciona</p>
          <h2>Em 4 passos</h2>
        </div>
        <div class="flow-wrap">
          <ol class="flow">
            {steps.map((s, i) => (
              <li>
                <span class="flow-node" aria-hidden="true"></span>
                <span class="flow-n">{String(i + 1).padStart(2, "0")}</span>
                <h3>{s.t}</h3>
                <p>{s.d}</p>
              </li>
            ))}
          </ol>
          <div class="loop" aria-hidden="true"><span>Melhoria contínua</span></div>
        </div>
      </div>
    </section>

    <section id="contacto" class="contact">
      <div class="wrap">
        <p class="sec-label"><b>03</b>Contacto</p>
        <h2>Pronto para te focares no que interessa?</h2>
        <a class="mail" href={`mailto:${email}`}>{email} <span class="arr" aria-hidden="true">→</span></a>
        <p class="contact-note">Conta-nos o que se repete no teu dia a dia. Respondemos com uma proposta.</p>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
