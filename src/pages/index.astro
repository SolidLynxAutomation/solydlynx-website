---
import Layout from "../layouts/Layout.astro";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const email = "geral@solidlynx.pt";
const services = [
  { t: "Tarefas CAD repetitivas", d: "Desenhos, listas e exportações geradas sozinhas." },
  { t: "Desenho paramétrico", d: "Variantes a partir de parâmetros, sem redesenhar." },
  { t: "Processos industriais", d: "Do CAD ao ERP e à máquina, sem copiar dados." },
];
const steps = [
  { t: "Fala-nos do processo", d: "Contas-nos o que se repete." },
  { t: "Otimizamos", d: "Desenhamos o processo mais simples." },
  { t: "Desenvolvemos", d: "Entregas curtas e frequentes." },
  { t: "Entregamos", d: "Pronto a usar, em SaaS." },
];
const principles = [
  { t: "Pagas só o que usas", d: "Cada funcionalidade tem preço próprio. Pagas pelo que usas." },
  { t: "Contacto direto", d: "Falas com quem desenvolve." },
];
---
<Layout title="SolidLynx · Foca-te no que interessa" description="Automatizamos tarefas repetitivas em software CAD, em formato SaaS.">
  <nav>
    <div class="wrap">
      <a class="logo" href="#"><img src={`${base}/logo.png`} alt="SolidLynx" height="40" />
      </a>
      <ul>
        <li><a href="#servicos">Serviços</a></li>
        <li><a href="#como">Como funciona</a></li>
        <li><a href="#preco">Preço</a></li>
        <li><a href="#contacto">Contacto</a></li>
      </ul>
    </div>
  </nav>

  <main>
    <header class="hero">
      <div class="wrap">
        <span class="pill">Automação CAD · SaaS</span>
        <h1>Foca-te no que <span class="grad">interessa</span></h1>
        <p class="lead">Automatizamos tarefas repetitivas em software CAD, em formato SaaS: desenvolvimento e correções contínuas, com adaptação rápida a mudanças no teu ambiente de trabalho.</p>
        <div class="cta">
          <a class="btn primary" href="#contacto">Pedir proposta</a>
          <a class="btn ghost" href="#servicos">Ver serviços</a>
        </div>
      </div>
    </header>

    <section id="servicos">
      <div class="wrap">
        <p class="eyebrow">Serviços</p>
        <h2>O que <span class="grad">fazemos</span></h2>
        <div class="grid">
          {services.map(s => (
            <article class="card"><h3>{s.t}</h3><p>{s.d}</p>{s.href && <a class="more" href={s.href}>Saber mais →</a>}</article>
          ))}
        </div>
      </div>
    </section>

    <section id="como">
      <div class="wrap">
        <p class="eyebrow">Como funciona</p>
        <h2>Em <span class="grad">4 passos</span></h2>
        <div class="steps-wrap">
          <div class="grid steps">
            {steps.map(s => (
              <article class="card"><h3>{s.t}</h3><p>{s.d}</p></article>
            ))}
          </div>
          <div class="loop" aria-hidden="true"><span>Melhoria contínua</span></div>
        </div>
      </div>
    </section>

    <section id="preco">
      <div class="wrap">
        <p class="eyebrow">Preço</p>
        <h2>Simplicidade e <span class="grad">eficiência</span></h2>
        <div class="grid">
          {principles.map(s => (
            <article class="card glow"><h3>{s.t}</h3><p>{s.d}</p></article>
          ))}
        </div>
      </div>
    </section>

    <section id="contacto" class="contact">
      <div class="wrap">
        <div class="box">
          <h2>Pronto para te focares no que <span class="grad">interessa</span>?</h2>
          <a class="btn primary" href={`mailto:${email}`}>{email}</a>
        </div>
      </div>
    </section>
  </main>

  <footer>
    <div class="wrap">
      <span>© {new Date().getFullYear()} SolidLynx</span>
      <span>Foca-te no que interessa</span>
    </div>
  </footer>
</Layout>
