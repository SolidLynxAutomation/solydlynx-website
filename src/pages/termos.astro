// Cada <h2 id="..."> é uma cláusula: a numeração e o índice são gerados sozinhos.
// Ao alterar o texto, suba a versão e a data em src/data/empresa.ts.
import Legal from "../layouts/Legal.astro";
import { empresa, identificacao } from "../data/empresa";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const { emailSuporte: suporte, emailGeral: geral } = empresa;
const foro = empresa.comarca
  ? `é competente o foro da comarca de ${empresa.comarca}, com renúncia expressa a qualquer outro`
  : "são competentes os tribunais portugueses";
